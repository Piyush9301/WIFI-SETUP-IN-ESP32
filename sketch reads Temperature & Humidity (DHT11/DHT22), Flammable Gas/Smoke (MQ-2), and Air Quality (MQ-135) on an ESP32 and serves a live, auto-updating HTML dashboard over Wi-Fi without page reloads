void setup() {
  Serial.begin(115200);
  pinMode(RESET_BTN_PIN, INPUT_PULLUP);
  pinMode(STATUS_LED_PIN, OUTPUT);
  digitalWrite(STATUS_LED_PIN, LOW);

  analogReadResolution(12); // ESP32 12-bit ADC (0 - 4095)
  dht.begin();

  // 1. Check if Wi-Fi credentials are already saved in NVS flash
  if (loadCredentialsFromNVS()) {
    Serial.printf("\n[NVS] Found saved Wi-Fi SSID: %s\n", savedSsid.c_str());
    Serial.printf("[NVS] Loaded saved API Key: %s\n", savedApiKey.c_str());
    Serial.print("[WIFI] Auto-connecting");

    WiFi.mode(WIFI_STA);
    WiFi.persistent(true);
    WiFi.begin(savedSsid.c_str(), savedPass.c_str());

    // Wait up to 15 seconds while keeping the reset button active
    unsigned long startAttempt = millis();
    while (WiFi.status() != WL_CONNECTED && (millis() - startAttempt < 15000)) {
      checkResetButton();
      delay(250);
      Serial.print(".");
    }
    Serial.println();
  }

  // 2. If no credentials were saved or auto-connect failed, launch WiFiProvisioner AP
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("[WIFI] Not connected. Launching WiFiProvisioner portal...");
    runProvisioningPortal();
  }

  // 3. Start the Live Sensor WebServer once connected
  if (WiFi.status() == WL_CONNECTED) {
    digitalWrite(STATUS_LED_PIN, HIGH); // Solid LED indicates online & ready
    Serial.println("\nWi-Fi Connected!");
    Serial.print("Open Live Dashboard at: http://");
    Serial.println(WiFi.localIP());
    Serial.println("Hold button on GPIO 13 for 3 seconds anytime to erase saved credentials.");

    server.on("/", handleRoot);
    server.on("/data", handleData);
    server.begin();
  } else {
    Serial.println("\nWi-Fi connection failed. Hold GPIO 13 for 3 seconds to reset.");
  }
}

void loop() {
  checkResetButton();

  if (WiFi.status() == WL_CONNECTED) {
    server.handleClient();
  }
}

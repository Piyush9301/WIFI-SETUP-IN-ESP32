// ---------------- Pin Definitions ----------------
#define DHTPIN 4            // Digital pin connected to DHT sensor
#define DHTTYPE DHT11       // Change to DHT22 if using a DHT22 sensor
#define MQ2_PIN 34          // Analog ADC1 pin for MQ-2
#define MQ135_PIN 35        // Analog ADC1 pin for MQ-135
#define RESET_BTN_PIN 13    // Push button connected between GPIO 13 and GND
#define STATUS_LED_PIN 2    // Onboard LED for status & reset feedback

// ---------------- Reset Button Timing ----------------
const unsigned long RESET_HOLD_MS = 3000; // 3 seconds hold time
unsigned long buttonPressStart = 0;
bool isButtonHeld = false;
bool resetTriggered = false;

DHT dht(DHTPIN, DHTTYPE);
WebServer server(80);
Preferences prefs;

String savedSsid = "";

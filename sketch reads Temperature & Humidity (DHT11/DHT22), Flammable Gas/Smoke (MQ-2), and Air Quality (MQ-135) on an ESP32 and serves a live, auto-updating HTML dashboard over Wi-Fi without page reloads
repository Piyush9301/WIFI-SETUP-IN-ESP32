// ---------------- Route Handlers ----------------
void handleRoot() {
  server.send(200, "text/html", INDEX_HTML);
}

void handleData() {
  float temperature = dht.readTemperature();
  float humidity = dht.readHumidity();

  // Average 10 samples to smooth analog noise from MQ sensors
  long mq2Sum = 0, mq135Sum = 0;
  for (int i = 0; i < 10; i++) {
    mq2Sum += analogRead(MQ2_PIN);
    mq135Sum += analogRead(MQ135_PIN);
    delay(5);
  }
  int mq2Val = mq2Sum / 10;
  int mq135Val = mq135Sum / 10;

  String json = "{";
  json += "\"ssid\":\"" + WiFi.SSID() + "\",";
  json += "\"temp\":" + (isnan(temperature) ? String("null") : String(temperature, 1)) + ",";
  json += "\"hum\":" + (isnan(humidity) ? String("null") : String(humidity, 1)) + ",";
  json += "\"mq2\":" + String(mq2Val) + ",";
  json += "\"mq135\":" + String(mq135Val);
  json += "}";

  server.send(200, "application/json", json);
}

// ---------------- Credential Storage Helpers ----------------
void saveCredentialsToNVS(const char* ssid, const char* password, const char* apiKey) {
  prefs.begin("krishimitree", false);
  prefs.putString("ssid", ssid ? String(ssid) : "");
  prefs.putString("pass", password ? String(password) : "");
  prefs.putString("apikey", apiKey ? String(apiKey) : "");
  prefs.end();
  Serial.println("[NVS] Wi-Fi credentials & API Key permanently saved to flash.");
}

bool loadCredentialsFromNVS() {
  prefs.begin("krishimitree", false);
  savedSsid = prefs.getString("ssid", "");
  savedPass = prefs.getString("pass", "");
  savedApiKey = prefs.getString("apikey", "");
  prefs.end();
  return savedSsid.length() > 0;
}

// ---------------- Factory Reset Logic ----------------
void triggerFactoryReset() {
  Serial.println("\n[RESET] Button held for 3 seconds! Erasing stored Wi-Fi & API Key settings...");

  for (int i = 0; i < 8; i++) {
    digitalWrite(STATUS_LED_PIN, !digitalRead(STATUS_LED_PIN));
    delay(80);
  }
  digitalWrite(STATUS_LED_PIN, LOW);

  server.stop();

  // Clear custom Preferences namespace
  prefs.begin("krishimitree", false);
  prefs.clear();
  prefs.end();

  // Wipe ESP32 Wi-Fi & full NVS partition
  WiFi.disconnect(true, true);
  WiFi.mode(WIFI_OFF);
  nvs_flash_erase();
  nvs_flash_init();

  Serial.println("[RESET] All credentials cleared. Restarting into provisioning AP mode...");
  delay(500);
  ESP.restart();
}

void checkResetButton() {
  if (digitalRead(RESET_BTN_PIN) == LOW) {
    if (!isButtonHeld) {
      isButtonHeld = true;
      buttonPressStart = millis();
      Serial.println("[INFO] Reset button pressed. Hold for 3 seconds to factory reset...");
    } else if (!resetTriggered && (millis() - buttonPressStart >= RESET_HOLD_MS)) {
      resetTriggered = true;
      triggerFactoryReset();
    }
  } else {
    if (isButtonHeld && !resetTriggered) {
      Serial.println("[INFO] Reset button released before 3 seconds. Canceled.");
    }
    isButtonHeld = false;
    buttonPressStart = 0;
  }
}

